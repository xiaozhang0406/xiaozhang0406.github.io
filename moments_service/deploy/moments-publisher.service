[Unit]
Description=Yarinaoshi Moments GitHub login and publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/moments-publisher
EnvironmentFile=/home/ubuntu/.config/moments-publisher/env
ExecStart=/usr/bin/python3 /home/ubuntu/moments-publisher/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.local/share/moments-publisher
MemoryMax=512M

[Install]
WantedBy=multi-user.target
