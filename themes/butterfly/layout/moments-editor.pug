extends includes/layout.pug

block content
  #page.moments-page.moments-editor.nc(data-owner='xiaozhang0406' data-repo='xiaozhang0406.github.io' data-api='https://planner.yarinaoshi.top/moments-api' data-public-url=url_for('/moments/') data-avatar=url_for(theme.avatar.img) data-author=config.author)
    .moments-editor-heading
      div
        a.moments-back(href=url_for('/moments/'))
          i.fas.fa-arrow-left(aria-hidden='true')
          |  返回碎碎念
        h1 写碎碎念
        p.moments-muted 不用想好标题，记录此刻就好。
      span.moments-private
        i.fas.fa-lock(aria-hidden='true')
        |  博主发布
    section.moment-card.moments-auth(aria-label='发布授权')
      .moments-auth-top
        div
          strong#moments-account 尚未登录 GitHub
          p#moments-auth-description.moments-muted 登录后就能从手机或电脑发布。
        button#moments-logout.moments-secondary(type='button' hidden) 退出登录
      .moments-login-actions#moments-login-panel
        button#moments-login-button.moments-button(type='button') 使用 GitHub 登录
        p.moments-small 在 GitHub 确认后即可发布；网页不会要求你粘贴凭据。
    .moments-editor-grid
      section.moment-card.moments-compose(aria-label='编辑碎碎念')
        form#moments-compose-form
          label.moments-compose-label(for='moments-content') 此刻在想什么？
          textarea#moments-content(rows='7' maxlength='4000' placeholder='一个想法、一件小事，或者今天拍到的画面……')
          .moments-compose-meta
            span
              i.far.fa-clock(aria-hidden='true')
              |  自动记录发布时间 · 北京时间
            span#moments-counter 0 / 4000
          #moments-attachments.moments-attachments(aria-label='已选择的图片')
          .moments-compose-actions
            label.moments-secondary.moments-upload(for='moments-images')
              i.far.fa-image(aria-hidden='true')
              |  添加图片
            input#moments-images.moments-file-input(type='file' accept='image/jpeg,image/png,image/webp,image/gif' multiple)
            span#moments-image-count.moments-small 纯文字也可以
          p.moments-small 最多 9 张图片，支持 JPG、PNG、WebP、GIF；每张不超过 8 MB，总计不超过 32 MB。
          .moments-publish-row
            span.moments-small 发布后所有访客可见
            button#moments-publish.moments-button(type='submit' disabled)
              i.fas.fa-paper-plane(aria-hidden='true')
              |  发布
      aside.moments-preview-column(aria-label='发布效果预览')
        .moments-preview-label
          i.far.fa-eye(aria-hidden='true')
          |  效果预览
        article.moment-card.moment-entry.moments-preview
          header.moment-header
            img.moments-avatar(src=url_for(theme.avatar.img) alt='' width='40' height='40')
            .moment-author
              strong= config.author
              time#moments-preview-time
          p#moments-preview-content.moment-text.moments-muted 你写下的文字和选择的图片会显示在这里。
          #moments-preview-images.moment-images
        p.moments-small.moments-preview-note 这只是预览，点击「发布」后才会保存到博客。
    p#moments-status.moments-status(role='status' aria-live='polite' hidden)
    noscript
      p.moment-card 网页编辑和发布需要启用 JavaScript。
  script(src=url_for('/js/moments-editor-v2.js?v=20260930-login3') defer)
